#!/bin/bash
echo balanced | sudo tee /sys/firmware/acpi/platform_profile > /dev/null
hyprctl eval 'hl.config({ decoration = { blur = { enabled = true }, active_opacity = 1.0, inactive_opacity = 1.0 }, animations = { enabled = true } })'
hyprctl eval 'hl.monitor({ output = "desc:Initio Corporation KJW27FIX 0x00000001", mode = "1920x1080@180", position = "0x0", scale = "1.5" })'
hyprctl eval 'hl.monitor({ output = "desc:BOE 0x0C29 0x00000067", mode = "1920x1080@144", position = "1280x159", scale = "1.5" })'
brightnessctl set 80%
notify-send "Modo normal" "Todo restaurado"
